@onready var animation_player: AnimationPlayer = $AnimationPlayer


func _ready() -> void:
	pass # Replace with function body.


func show_message():
	animation_player.play(\"ShowReply\")
	await animation_player.animation_finished

func play_sound():
	$NotificationSound.play()
"

